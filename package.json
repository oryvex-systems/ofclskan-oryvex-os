{
  "name": "oryvex-os",
  "private": true,
  "version": "0.1.0",
  "description": "ORYVEX OS monorepo for TIKLADOY, BURGERMY and shared commerce services.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:tikladoy": "npm --workspace apps/tikladoy run dev",
    "dev:burgermy": "npm --workspace apps/burgermy run dev",
    "build:tikladoy": "npm --workspace apps/tikladoy run build",
    "build:burgermy": "npm --workspace apps/burgermy run build"
  }
}
